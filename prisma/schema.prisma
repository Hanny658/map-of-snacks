// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

enum Stock {
  plenty
  mid
  low
  gone
}

enum UserStatus {
  pending       // special status reserved for apply-approve process
  active        // normal active user
  contributor   // contributor user, higher access to the functions
  banned        // user that disobeyed the community rules, reserved to prevent re-registration
}

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==== Following are the data types, note that each one should have a "name" field for displaying ====

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String   @unique @db.VarChar(32)  // Unique username with application-limit of 32 chars
  password  String
  avatar    String?                           // Avatar picture
  bio       String?
  status    UserStatus? @default(active)
  createdAt DateTime @default(now())
}

model Place {
  identifier String   @id @unique @default(uuid())
  name       String
  address    String?
  lng        Float
  lat        Float
  cheapies   Cheapie[]
}

model Cheapie {
  id       Int      @id @default(autoincrement())
  name     String
  store    String
  quantity Int
  price    Float
  addBy    String      @default("System") @db.VarChar(32)
  exp      DateTime?
  image    String?
  stock      Stock     @default(low)
  createdAt  DateTime  @default(now())

  place    Place    @relation(fields: [store], references: [identifier])
}
